{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^startup$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/gh_axi_context.py\"",
            "timeout": 10,
            "statusMessage": "Loading GitHub dashboard"
          }
        ]
      }
    ]
  }
}
