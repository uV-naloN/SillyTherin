OPENROUTER_API_KEY=your-key-here
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Enabling Langfuse sends real messages and replies, potentially including secrets
# and private notebook/document text. Review project access and retention first.
# Restart after changing these settings. Text is limited to 64 KiB per field.
# Optional Langfuse Cloud reply tracing (off unless explicitly enabled):
# SILLYTHERIN_LANGFUSE_ENABLED=true
# SILLYTHERIN_LANGFUSE_REGION=eu
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
